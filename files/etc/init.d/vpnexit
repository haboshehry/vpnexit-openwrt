#!/bin/sh /etc/rc.common
# vpnexit supervisor: keeps the CHILD_SA alive, re-applies routing and refreshes
# the profile feed once a day. procd restarts it if it ever exits.

START=96
STOP=08
USE_PROCD=1

start_service() {
	procd_open_instance supervisor
	procd_set_param command /usr/sbin/vpnexit supervise
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_set_param file /etc/config/vpnexit
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger vpnexit
}

reload_service() {
	stop
	start
}
